  "fields": [
    {
      "label": "شكل صورة المنتج في البطاقات",
      "type": "قائمة منسدلة",
      "default": "مربع 1:1 (الافتراضي)",
      "what": "يطبَّق على بطاقات المنتجات في كل القوائم والمكوّنات. الطولي يناسب الصور الملتقطة بالطول (أزياء، عطور)؛ الصورة المربعة تُقص من جانبيها فيه، إلا إذا اخترت «احتواء» من توحيد ارتفاع البطاقات في إعدادات المنتجات بلوحة سلة.",
      "when": "",
      "empty": "",
      "shows_when": "",
      "pairs": [
        {
          "panel": "../../images/settings-10-product-image-ratio-product-image-ratio-square-panel.webp",
          "result": "",
          "option": "مربع 1:1 (الافتراضي)",
          "note": "القيمة الافتراضية."
        },
        {
          "panel": "../../images/settings-10-product-image-ratio-product-image-ratio-portrait-3-4-panel.webp",
          "result": "",
          "option": "طولي 3:4",
          "note": ""
        },
        {
          "panel": "../../images/settings-10-product-image-ratio-product-image-ratio-portrait-4-5-panel.webp",
          "result": "",
          "option": "طولي خفيف 4:5",
          "note": ""
        }
      ],
      "options": [
        "مربع 1:1 (الافتراضي)",
        "طولي 3:4",
        "طولي خفيف 4:5"
      ]
    },
    {
      "label": "تبديل صورة المنتج عند التأشير",
      "type": "مفتاح",
      "default": "مفعّل",
      "what": "عند تمرير الماوس على بطاقة منتج له صورتان أو أكثر تظهر صورته الثانية. يعمل على أجهزة الكمبيوتر فقط، ولا يتغيّر شيء للمنتج الذي فيه فيديو أو صورة واحدة. يجلب صور منتجات الصفحة القريبة من الشاشة في طلبات مجمَّعة (حتى 40 منتجًا لكل طلب).",
      "when": "",
      "empty": "",
      "shows_when": "",
      "pairs": [
